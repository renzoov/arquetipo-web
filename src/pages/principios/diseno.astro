---
// Principios de diseño: las ideas generales que están detrás de SOLID y de los patrones.
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { formato, ui } from '../../contenido/ui';
import { ENCABEZADO as e, PRINCIPIOS_DISENO } from '../../contenido/diseno';
import { nombrePatron, rutaPatron } from '../../data/catalogo';
import { resaltar } from '../../lib/codigo';


const principios = await Promise.all(
  PRINCIPIOS_DISENO.map(async (p) => ({
    ...p,
    htmlAntes: await resaltar(p.antes),
    htmlDespues: await resaltar(p.despues),
    enlaces: p.patrones.map((slug) => ({ nombre: nombrePatron(slug), href: rutaPatron(slug) })),
  })),
);
---

<Layout title={`${e.titulo} · Arquetipo`} description={e.descripcion}>
  <Navbar />

  <main class="w-full bg-background min-h-screen">
    <div class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-10 py-8 flex flex-col gap-12">

      <!-- Encabezado -->
      <header class="flex flex-col gap-4">
        <nav class="flex items-center gap-2 font-telemetry text-xs text-on-surface-variant" aria-label={ui.ruta}>
          <a href={'/'} class="hover:text-primary">{ui.inicio}</a>
          <span>/</span>
          <span class="text-primary-container">{e.titulo}</span>
        </nav>
        <span class="font-badge text-[10px] text-secondary-container uppercase tracking-widest">{formato(ui.pasoDeLaRuta, { n: '02' })}</span>
        <h1 class="font-headline text-4xl sm:text-5xl font-bold text-primary"><span transition:name="titulo-diseno" class="inline-block">{e.titulo}</span></h1>
        <p class="font-body text-lg text-slate-200 max-w-4xl leading-relaxed">{e.intro}</p>
        <nav class="flex flex-wrap gap-2 pt-1" aria-label={e.titulo}>
          {principios.map((p) => (
            <a href={`#${p.id}`} class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-container-low border border-surface-container-high hover:border-primary-container/40 font-body text-sm text-slate-200 transition-colors">
              <span class={`material-symbols-outlined text-[17px] ${p.color}`}>{p.icono}</span>{p.nombre}
            </a>
          ))}
        </nav>
      </header>

      {principios.map((p) => (
        <article id={p.id} class="scroll-mt-24 p-6 lg:p-8 rounded-xl bg-surface-container-lowest/90 border border-surface-container-high flex flex-col gap-6">
          <div class="flex items-center justify-between flex-wrap gap-3 pb-4 border-b border-surface-container-high">
            <div class="flex items-center gap-3">
              <span class={`w-11 h-11 rounded-lg border flex items-center justify-center shrink-0 ${p.fondo} ${p.color}`}>
                <span class="material-symbols-outlined text-[24px]">{p.icono}</span>
              </span>
              <h2 class="font-headline text-2xl text-primary font-bold">{p.nombre}</h2>
            </div>
            <span class={`font-badge text-xs px-2.5 py-1 rounded bg-surface-container-high font-bold uppercase ${p.color}`}>{p.lema}</span>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 font-body text-[15px] text-slate-200 leading-relaxed">
            <p><strong class="text-primary">{ui.queDice}</strong> {p.definicion}</p>
            <p><strong class="text-amber-300">{ui.comoReconocer}</strong> {p.sintoma}</p>
          </div>

          <div class="grid grid-cols-1 xl:grid-cols-2 gap-5">
            <div>
              <span class="font-badge text-xs text-amber-300 font-bold uppercase mb-2 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[16px]">cancel</span>{ui.antesIncumple}
              </span>
              <div class="shiki-wrapper" set:html={p.htmlAntes}></div>
            </div>
            <div>
              <span class="font-badge text-xs text-secondary-container font-bold uppercase mb-2 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[16px]">check_circle</span>{ui.despuesCumple}
              </span>
              <div class="shiki-wrapper" set:html={p.htmlDespues}></div>
            </div>
          </div>

          <p class="p-4 rounded-lg bg-primary-container/5 border border-primary-container/20 font-body text-sm text-slate-200 leading-relaxed">
            <span class="text-primary-container font-bold">{ui.enLaPractica}</span> {p.practica}
          </p>

          <div class="flex flex-wrap items-center gap-2">
            <span class="font-badge text-[11px] text-on-surface-variant uppercase tracking-wider mr-1">{e.loVerasEn}</span>
            {p.enlaces.map((x) => (
              <a href={x.href} class="px-3 py-1 rounded-full bg-surface-container-low border border-surface-container-high hover:border-primary-container/40 font-code text-xs text-slate-200 transition-colors">{x.nombre}</a>
            ))}
          </div>
        </article>
      ))}

      <a href={'/principios/solid'} class="self-end inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-primary-container text-on-primary font-body text-sm font-semibold hover:bg-primary transition-colors">
        {e.siguiente} <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
      </a>
    </div>
    <Footer />
  </main>
</Layout>
