---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/inicio/Hero.astro';
import RutaAprendizaje from '../components/inicio/RutaAprendizaje.astro';
import PilaresPoo from '../components/inicio/PilaresPoo.astro';
import PrincipiosSolid from '../components/inicio/PrincipiosSolid.astro';
import CatalogoPatrones from '../components/inicio/CatalogoPatrones.astro';
import Lenguajes from '../components/inicio/Lenguajes.astro';
import Profundizar from '../components/inicio/Profundizar.astro';
---

<Layout title="Arquetipo · Patrones de diseño de software">
  <Navbar />
  <main class="w-full bg-background min-h-screen">
    <div class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-10 py-8 lg:py-12 flex flex-col gap-14">
      <Hero />
      <RutaAprendizaje />
      <PilaresPoo />
      <PrincipiosSolid />
      <CatalogoPatrones />
      <Profundizar idioma="es" />
      <Lenguajes />
    </div>
    <Footer />
  </main>
</Layout>
