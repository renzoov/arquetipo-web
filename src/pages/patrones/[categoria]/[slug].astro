---
// Página de un patrón: caso real, diagrama, código antes y después, cuándo usarlo y el código en 8 lenguajes.
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import BloqueCodigo from '../../../components/BloqueCodigo.astro';
import EjerciciosPatron from '../../../components/EjerciciosPatron.astro';
import MarcarEstudiado from '../../../components/MarcarEstudiado.astro';
import { formato, ui } from '../../../contenido/ui';
import { COLOR_CATEGORIA, PATRONES, nombrePatron, rutaPatron, type PatternData } from '../../../data/catalogo';
import { LENGUAJES, ejemplo, nombreArchivo } from '../../../data/lenguajes';
import { COMPARACIONES } from '../../../contenido/comparaciones';
import { resaltar } from '../../../lib/codigo';
import DiagramaArchify from '../../../components/DiagramaArchify.astro';

export function getStaticPaths() {
  return PATRONES.map((p) => ({ params: { categoria: p.category, slug: p.slug }, props: { pattern: p } }));
}

interface Props {
  pattern: PatternData;
}

const { pattern } = Astro.props;

const indice = PATRONES.findIndex((p) => p.slug === pattern.slug);
const anterior = PATRONES[indice - 1];
const siguiente = PATRONES[indice + 1];

const color = COLOR_CATEGORIA[pattern.category];

const codigoSin = await resaltar(pattern.codigoProblematico);
const codigoCon = await resaltar(pattern.codigoSolucion);
// Comparaciones con los patrones con los que se suele confundir
const comparaciones = COMPARACIONES.filter((c) => c.patrones.includes(pattern.slug)).map((c) => ({
  id: c.id,
  otros: c.patrones.filter((s) => s !== pattern.slug).map(nombrePatron).join(' / '),
}));
const href = (p: PatternData) => rutaPatron(p.slug);

const ejemplos = LENGUAJES.map((l) => ({ lenguaje: l, ejemplo: ejemplo(l, pattern.slug) }));
---

<Layout title={`${pattern.name} · ${pattern.categoryLabel} · Arquetipo`} description={pattern.purpose}>
  <Navbar />

  <main class="w-full bg-background min-h-screen">
    <div class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-10 py-8 flex flex-col gap-10">

      <!-- Encabezado -->
      <header class="flex flex-col gap-5">
        <nav class="flex flex-wrap items-center gap-2 font-telemetry text-xs text-on-surface-variant" aria-label={ui.ruta}>
          <a href="/" class="hover:text-primary">{ui.inicio}</a>
          <span>/</span>
          <a href="/#patrones" class="hover:text-primary">{ui.patrones}</a>
          <span>/</span>
          <span class={color.texto}>{pattern.categoryLabel}</span>
        </nav>

        <div class="flex flex-wrap gap-2 font-badge text-[11px]">
          <span class={`px-2.5 py-1 rounded border ${color.borde} ${color.fondo} ${color.texto} font-bold uppercase`}>{pattern.categoryLabel}</span>
          <span class="px-2.5 py-1 rounded border border-surface-container-high bg-surface-container-low text-on-surface-variant">{ui.uso}: {pattern.frecuenciaUso}</span>
          <span class="px-2.5 py-1 rounded border border-surface-container-high bg-surface-container-low text-on-surface-variant">{ui.complejidad}: {pattern.complejidad}</span>
        </div>

        <div class="flex flex-col gap-2">
          <h1 transition:name={`patron-${pattern.slug}`} class="font-headline text-4xl sm:text-5xl font-bold text-primary w-fit">{pattern.name}</h1>
          <p class="font-telemetry text-sm text-on-surface-variant">{pattern.aka}</p>
          <MarcarEstudiado id={`patron:${pattern.slug}`} />
        </div>

        <p class="font-body text-lg text-slate-200 leading-relaxed max-w-4xl">{pattern.purpose}</p>

        <p class="max-w-4xl px-4 py-3 rounded-lg bg-surface-container-low border-l-2 border-amber-400/60 font-body text-base text-amber-200/90 italic">
          “{pattern.problema}”
        </p>
      </header>

      <!-- 1. Caso real -->
      <section class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="p-6 rounded-xl bg-surface-container-lowest/90 border border-surface-container-high flex flex-col gap-3">
          <h2 class="font-badge text-xs uppercase tracking-wider text-primary-container font-bold flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">work</span>{ui.casoReal}
          </h2>
          <p class="font-body text-[15px] text-slate-200 leading-relaxed">{pattern.historiaReal}</p>
        </div>

        <div class="p-6 rounded-xl bg-surface-container-lowest/90 border border-surface-container-high flex flex-col gap-5">
          <div class="flex flex-col gap-2">
            <h2 class="font-badge text-xs uppercase tracking-wider text-amber-300 font-bold flex items-center gap-2">
              <span class="material-symbols-outlined text-[18px]">warning</span>{ui.problemaSinPatron}
            </h2>
            <p class="font-body text-[15px] text-slate-200 leading-relaxed">{pattern.dolorIngenuo}</p>
          </div>
          <div class="flex flex-col gap-2 pt-4 border-t border-surface-container-high">
            <h2 class="font-badge text-xs uppercase tracking-wider text-secondary-container font-bold flex items-center gap-2">
              <span class="material-symbols-outlined text-[18px]">check_circle</span>{ui.comoLoResuelve}
            </h2>
            <p class="font-body text-[15px] text-slate-200 leading-relaxed">{pattern.solucionPatron}</p>
          </div>
        </div>
      </section>

      <!-- 2. Diagrama -->
      <section class="flex flex-col gap-3">
        <h2 class="font-headline text-2xl font-bold uppercase text-primary flex items-center gap-2">
          <span class="material-symbols-outlined text-primary-container">schema</span>{ui.diagramaClases}
        </h2>
        <DiagramaArchify archivo={`${pattern.slug}.class.html`} titulo={formato(ui.diagramaDe, { x: pattern.name })} />
        <p class="font-body text-xs text-on-surface-variant">
          {ui.diagramaAyuda}
        </p>
      </section>

      <!-- 3. Código antes / después -->
      <section class="flex flex-col gap-4">
        <h2 class="font-headline text-2xl font-bold uppercase text-primary flex items-center gap-2">
          <span class="material-symbols-outlined text-primary-container">code</span>{ui.codigoAntesDespues}
        </h2>
        <div class="grid grid-cols-1 xl:grid-cols-2 gap-5">
          <div class="flex flex-col rounded-xl border border-amber-400/30 bg-surface-container-low overflow-hidden">
            <div class="flex items-center justify-between px-4 py-2.5 border-b border-surface-container-high">
              <span class="font-badge text-[11px] uppercase font-bold text-amber-300 flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[16px]">cancel</span>{ui.sinPatron}
              </span>
              <span class="font-badge text-[10px] text-amber-300/80">{ui.antes}</span>
            </div>
            <div class="shiki-wrapper shiki-plano" set:html={codigoSin}></div>
          </div>
          <div class="flex flex-col rounded-xl border border-secondary-container/30 bg-surface-container-low overflow-hidden">
            <div class="flex items-center justify-between px-4 py-2.5 border-b border-surface-container-high">
              <span class="font-badge text-[11px] uppercase font-bold text-secondary-container flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[16px]">check_circle</span>{ui.conPatron}
              </span>
              <span class="font-badge text-[10px] text-secondary-container/80">{ui.despues}</span>
            </div>
            <div class="shiki-wrapper shiki-plano" set:html={codigoCon}></div>
          </div>
        </div>
        <p class="font-body text-xs text-on-surface-variant">
          {ui.notaEjemplosTs}
        </p>
      </section>

      {pattern.nota && (
        <section class="p-5 rounded-xl bg-primary-container/5 border border-primary-container/25 flex gap-4">
          <span class="material-symbols-outlined text-primary-container text-[24px] shrink-0">lightbulb</span>
          <div class="flex flex-col gap-1.5">
            <h2 class="font-badge text-xs uppercase tracking-wider text-primary-container font-bold">{ui.matiz}</h2>
            <p class="font-body text-[15px] text-slate-200 leading-relaxed">{pattern.nota}</p>
          </div>
        </section>
      )}

      <!-- 4. Cuándo usarlo -->
      <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 rounded-xl bg-surface-container-low border border-surface-container-high flex flex-col gap-3">
          <h2 class="font-badge text-xs uppercase tracking-wider text-secondary-container font-bold flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">thumb_up</span>{ui.cuandoUsarlo}
          </h2>
          <ul class="flex flex-col gap-2.5">
            {pattern.cuandoUsarlo.map((c) => (
              <li class="font-body text-sm text-slate-200 leading-relaxed flex gap-2.5">
                <span class="text-secondary-container font-bold">✓</span><span>{c}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="p-6 rounded-xl bg-surface-container-low border border-amber-400/30 flex flex-col gap-3">
          <h2 class="font-badge text-xs uppercase tracking-wider text-amber-300 font-bold flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">do_not_disturb_on</span>{ui.cuandoNoUsarlo}
          </h2>
          <ul class="flex flex-col gap-2.5">
            {pattern.cuandoNoUsarlo.map((c) => (
              <li class="font-body text-sm text-slate-200 leading-relaxed flex gap-2.5">
                <span class="text-amber-400 font-bold">✕</span><span>{c}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <!-- 5. Principios y relaciones -->
      <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-6 rounded-xl bg-surface-container-lowest/90 border border-surface-container-high flex flex-col gap-3">
          <h2 class="font-badge text-xs uppercase tracking-wider text-primary-container font-bold flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">memory</span>{ui.principiosEnJuego}
          </h2>
          <ul class="flex flex-col gap-2.5">
            {pattern.principiosClave.map((p) => (
              <li class="font-body text-sm text-slate-200 leading-relaxed flex gap-2.5">
                <span class="text-primary-container">•</span><span>{p}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="p-6 rounded-xl bg-surface-container-lowest/90 border border-surface-container-high flex flex-col gap-3">
          <h2 class="font-badge text-xs uppercase tracking-wider text-tertiary-fixed-dim font-bold flex items-center gap-2">
            <span class="material-symbols-outlined text-[18px]">hub</span>{ui.relacionados}
          </h2>
          <ul class="flex flex-col gap-2.5">
            {pattern.relaciones.map((r) => (
              <li class="font-body text-sm text-slate-200 leading-relaxed flex gap-2.5">
                <span class="text-tertiary-fixed-dim">•</span><span>{r}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {comparaciones.length > 0 && (
        <section class="p-5 rounded-xl bg-surface-container-low border border-surface-container-high flex flex-wrap items-center gap-3">
          <span class="font-badge text-xs uppercase tracking-wider text-primary-container font-bold flex items-center gap-2 mr-1">
            <span class="material-symbols-outlined text-[18px]">compare_arrows</span>{ui.seConfundeCon}
          </span>
          {comparaciones.map((c) => (
            <a href={`/comparaciones#${c.id}`} class="px-3 py-1.5 rounded-full bg-surface-container-lowest border border-surface-container-high hover:border-primary-container/40 font-code text-xs text-slate-200 transition-colors">
              {pattern.name} vs {c.otros} →
            </a>
          ))}
        </section>
      )}

      <EjerciciosPatron slug={pattern.slug} />

      <!-- 6. En tu lenguaje -->
      <section id="en-tu-lenguaje" class="scroll-mt-24 flex flex-col gap-4">
        <div class="flex items-end justify-between flex-wrap gap-3">
          <div>
            <h2 class="font-headline text-2xl font-bold uppercase text-primary flex items-center gap-2">
              <span class="material-symbols-outlined text-amber-300">code_blocks</span>{formato(ui.enTuLenguaje, { x: pattern.name })}
            </h2>
            <p class="font-body text-sm text-slate-300 mt-1">{ui.enTuLenguajeIntro}</p>
          </div>
          {ejemplos.length > 0 && (
            <div class="flex flex-wrap gap-2 font-telemetry text-[12px]" role="tablist" aria-label={ui.lenguaje}>
              {ejemplos.map(({ lenguaje }, i) => (
                <button type="button" role="tab" data-pestana={lenguaje.id} aria-selected={i === 0 ? 'true' : 'false'}
                  class="pestana-lenguaje px-3 py-1.5 rounded-full border border-surface-container-high bg-surface-container-low text-on-surface-variant hover:text-primary aria-selected:border-amber-400/40 aria-selected:bg-amber-400/10 aria-selected:text-amber-200">
                  {lenguaje.nombre}
                </button>
              ))}
            </div>
          )}
        </div>

        {ejemplos.map(({ lenguaje, ejemplo: e }, i) => (
          <div data-panel={lenguaje.id} role="tabpanel" class={i === 0 ? '' : 'hidden'}>
            <BloqueCodigo lenguaje={lenguaje} archivo={nombreArchivo(lenguaje, pattern.slug)} ejemplo={e} />
            <a href={`/lenguajes/${lenguaje.id}#${pattern.slug}`} class="inline-block mt-2 font-badge text-[11px] uppercase tracking-wider text-primary-container hover:text-primary-fixed">
              {formato(ui.verLos23En, { x: lenguaje.nombre })}
            </a>
          </div>
        ))}

      </section>

      <!-- Navegación entre patrones -->
      <nav class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-6 border-t border-surface-container-high" aria-label={ui.otrosPatrones}>
        {anterior ? (
          <a href={href(anterior)} class="p-4 rounded-xl bg-surface-container-low border border-surface-container-high hover:border-primary-container/40 transition-colors flex flex-col gap-1">
            <span class="font-telemetry text-[11px] text-on-surface-variant">{ui.anterior}</span>
            <span class="font-code text-sm font-bold text-primary">{anterior.name}</span>
          </a>
        ) : <span></span>}
        {siguiente ? (
          <a href={href(siguiente)} class="p-4 rounded-xl bg-surface-container-low border border-surface-container-high hover:border-primary-container/40 transition-colors flex flex-col gap-1 sm:items-end text-right">
            <span class="font-telemetry text-[11px] text-on-surface-variant">{ui.siguiente}</span>
            <span class="font-code text-sm font-bold text-primary">{siguiente.name}</span>
          </a>
        ) : (
          <a href="/#patrones" class="p-4 rounded-xl bg-surface-container-low border border-surface-container-high hover:border-primary-container/40 transition-colors flex flex-col gap-1 sm:items-end text-right">
            <span class="font-telemetry text-[11px] text-on-surface-variant">{ui.alFinal}</span>
            <span class="font-code text-sm font-bold text-primary">{ui.volverCatalogo}</span>
          </a>
        )}
      </nav>
    </div>
    <Footer />
  </main>
</Layout>

<script>
  // Pestañas de lenguaje (con una transición suave al cambiar de lenguaje)
  document.addEventListener('astro:page-load', () => {
    const pestanas = document.querySelectorAll<HTMLButtonElement>('.pestana-lenguaje');
    pestanas.forEach((pestana) => {
      pestana.addEventListener('click', () => {
        const cambiar = () => {
          pestanas.forEach((p) => p.setAttribute('aria-selected', String(p === pestana)));
          document.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) => {
            panel.classList.toggle('hidden', panel.dataset.panel !== pestana.dataset.pestana);
          });
        };
        if (document.startViewTransition) document.startViewTransition(cambiar);
        else cambiar();
      });
    });
  });
</script>
