---
// Fundamentos de POO: los 4 pilares y las 4 relaciones entre clases.
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import MarcarEstudiado from '../../components/MarcarEstudiado.astro';
import { formato, ui } from '../../contenido/ui';
import { ENCABEZADO as e, PILARES, RELACIONES } from '../../contenido/poo';
import { resaltar } from '../../lib/codigo';


const TONO = {
  primario: { titulo: 'text-primary-container', borde: 'border-surface-container-high' },
  secundario: { titulo: 'text-secondary-container', borde: 'border-surface-container-high' },
  aviso: { titulo: 'text-amber-300', borde: 'border-amber-500/30' },
};

const pilares = await Promise.all(PILARES.map(async (p) => ({ ...p, html: await resaltar(p.codigo) })));
const relaciones = await Promise.all(RELACIONES.map(async (r) => ({ ...r, html: await resaltar(r.codigo) })));
---

<Layout title={`${e.titulo} · Arquetipo`} description={e.descripcion}>
  <Navbar />

  <main class="w-full bg-background min-h-screen">
    <div class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-10 py-8 flex flex-col gap-12">

      <!-- Encabezado -->
      <header class="flex flex-col gap-4">
        <nav class="flex items-center gap-2 font-telemetry text-xs text-on-surface-variant" aria-label={ui.ruta}>
          <a href="/" class="hover:text-primary">{ui.inicio}</a>
          <span>/</span>
          <span class="text-secondary-container">{e.titulo}</span>
        </nav>
        <span class="font-badge text-[10px] text-secondary-container uppercase tracking-widest">{formato(ui.pasoDeLaRuta, { n: '01' })}</span>
        <h1 transition:name="titulo-poo" class="font-headline text-4xl sm:text-5xl font-bold text-primary w-fit">{e.titulo}</h1>
        <p class="font-body text-lg text-slate-200 max-w-4xl leading-relaxed">{e.intro}</p>
        <MarcarEstudiado id="poo" />
      </header>

      <!-- Diagrama de los 4 pilares -->
      <section class="flex flex-col gap-3">
        <h2 class="font-headline text-2xl font-bold uppercase text-primary flex items-center gap-2">
          <span class="material-symbols-outlined text-primary-container">schema</span>{e.diagramaPilares}
        </h2>
        <div class="rounded-xl overflow-hidden border border-surface-container-high bg-[#0b0e15]">
          <iframe
            src="/diagrams/poo-pilares.class.html"
            title={formato(ui.diagramaDe, { x: e.diagramaPilares })}
            class="w-full h-[760px] border-0 archify-frame block"
            scrolling="no"
          ></iframe>
        </div>
      </section>

      <!-- 1. Los 4 pilares -->
      <section class="flex flex-col gap-6">
        <h2 class="font-headline text-2xl font-bold uppercase text-primary flex items-center gap-2 border-b border-surface-container-high pb-2">
          <span class="material-symbols-outlined text-secondary-container">account_tree</span>{e.tituloPilares}
        </h2>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {pilares.map((p, i) => (
            <article id={p.id} class="scroll-mt-24 p-6 rounded-xl bg-surface-container-lowest/90 border border-surface-container-high flex flex-col gap-4">
              <div class="flex items-center justify-between">
                <span class={`font-badge text-xs px-2.5 py-1 rounded font-bold border ${p.estilo}`}>PILAR {String(i + 1).padStart(2, '0')}</span>
                <span class="font-telemetry text-xs text-on-surface-variant">{p.lema}</span>
              </div>
              <h3 class="font-headline text-2xl text-primary font-bold">{p.nombre}</h3>
              <p class="font-body text-[15px] text-slate-200 leading-relaxed" set:html={p.explicacion} />
              <div class="shiki-wrapper" set:html={p.html}></div>
              <p class={`p-4 rounded-lg bg-surface-container-low border font-body text-sm text-slate-200 leading-relaxed ${TONO[p.nota.tono].borde}`}>
                <span class={`font-bold block mb-1 ${TONO[p.nota.tono].titulo}`}>{p.nota.titulo}</span>
                <Fragment set:html={p.nota.texto} />
              </p>
            </article>
          ))}
        </div>
      </section>

      <!-- Diagrama de relaciones -->
      <section class="flex flex-col gap-3">
        <h2 class="font-headline text-2xl font-bold uppercase text-primary flex items-center gap-2">
          <span class="material-symbols-outlined text-primary-container">hub</span>{e.diagramaRelaciones}
        </h2>
        <div class="rounded-xl overflow-hidden border border-surface-container-high bg-[#0b0e15]">
          <iframe
            src="/diagrams/poo-relaciones.class.html"
            title={formato(ui.diagramaDe, { x: e.diagramaRelaciones })}
            class="w-full h-[760px] border-0 archify-frame block"
            scrolling="no"
          ></iframe>
        </div>
      </section>

      <!-- 2. Las 4 relaciones -->
      <section class="flex flex-col gap-6">
        <div class="flex items-center justify-between flex-wrap gap-2 border-b border-surface-container-high pb-2">
          <h2 class="font-headline text-2xl font-bold uppercase text-primary flex items-center gap-2">
            <span class="material-symbols-outlined text-primary-container">hub</span>{e.tituloRelaciones}
          </h2>
          <span class="font-telemetry text-xs text-secondary-container">{e.ordenRelaciones}</span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          {relaciones.map((r, i) => (
            <article id={r.id} class={`scroll-mt-24 p-6 rounded-xl bg-surface-container-lowest/90 border flex flex-col gap-4 ${r.destacado ? 'border-secondary-container/40' : 'border-surface-container-high'}`}>
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h3 class={`font-headline text-xl font-bold ${r.destacado ? 'text-secondary-container' : 'text-primary'}`}>{i + 1}. {r.nombre} <span class="font-body text-base font-normal text-on-surface-variant">· {r.subtitulo}</span></h3>
                  <span class="font-telemetry text-xs text-on-surface-variant">UML: {r.uml}</span>
                </div>
                <span class="font-badge text-[10px] px-2 py-1 rounded bg-surface-container-high text-primary font-bold shrink-0 uppercase">{r.etiqueta}</span>
              </div>
              <p class="font-body text-[15px] text-slate-200 leading-relaxed">{r.texto}</p>
              <div class="shiki-wrapper" set:html={r.html}></div>
            </article>
          ))}
        </div>

        <p class="p-4 rounded-lg bg-primary-container/5 border border-primary-container/20 font-body text-sm text-slate-200 leading-relaxed">
          <span class="text-primary-container font-bold">{ui.ademas}</span> <Fragment set:html={e.ademas} />
        </p>
      </section>

      <div class="flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-surface-container-high">
        <MarcarEstudiado id="poo" />
        <a href="/principios/diseno" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-primary-container text-on-primary font-body text-sm font-semibold hover:bg-primary transition-colors">
          {e.siguiente} <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
        </a>
      </div>
    </div>
    <Footer />
  </main>
</Layout>
