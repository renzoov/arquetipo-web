---
// Ejercicios: elegir la sección (POO, SOLID o patrones). Cada intento sortea preguntas nuevas.
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { ui } from '../../contenido/ui';
import { EJERCICIOS as E } from '../../contenido/inicio';
import { SECCIONES } from '../../contenido/ejercicios/index';

const total = SECCIONES.reduce((n, s) => n + s.preguntas.length, 0);
---

<Layout title={`${E.titulo} · Arquetipo`} description={E.descripcion}>
  <Navbar />

  <main class="w-full bg-background min-h-screen">
    <div class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-10 py-8 flex flex-col gap-10">
      <header class="flex flex-col gap-4">
        <nav class="flex items-center gap-2 font-telemetry text-xs text-on-surface-variant" aria-label={ui.ruta}>
          <a href="/" class="hover:text-primary">{ui.inicio}</a>
          <span>/</span>
          <span class="text-primary-container">{E.titulo}</span>
        </nav>
        <h1 class="font-headline text-4xl sm:text-5xl font-bold text-primary">{E.titulo}</h1>
        <p class="font-body text-lg text-slate-200 max-w-4xl leading-relaxed">{E.intro}</p>
        <p class="font-telemetry text-xs text-on-surface-variant">{total} preguntas en total · cada intento sortea preguntas distintas</p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {SECCIONES.map((s) => (
          <a href={`/ejercicios/${s.id}`} data-seccion={s.id} class={`p-6 rounded-xl bg-surface-container-lowest/90 border border-surface-container-high ${s.borde} transition-all flex flex-col gap-4`}>
            <span class={`w-12 h-12 rounded-lg bg-surface-container-high flex items-center justify-center ${s.color}`}>
              <span class="material-symbols-outlined text-[26px]">{s.icono}</span>
            </span>
            <h2 class="font-headline text-2xl font-bold text-slate-100">{s.titulo}</h2>
            <p class="font-body text-sm text-slate-300 leading-relaxed">{s.descripcion}</p>
            <dl class="mt-auto grid grid-cols-2 gap-3 pt-4 border-t border-surface-container-high">
              <div>
                <dt class="font-badge text-[10px] uppercase tracking-wider text-on-surface-variant">Banco</dt>
                <dd class="font-code text-lg font-bold text-slate-100">{s.preguntas.length}</dd>
              </div>
              <div>
                <dt class="font-badge text-[10px] uppercase tracking-wider text-on-surface-variant">Por intento</dt>
                <dd class="font-code text-lg font-bold text-slate-100">{s.porIntento}</dd>
              </div>
            </dl>
            <span class="flex items-center justify-between gap-2">
              <span class="mejor font-telemetry text-xs text-on-surface-variant" hidden></span>
              <span class={`font-badge text-[11px] uppercase tracking-wider ${s.color}`}>{E.empezar}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
    <Footer />
  </main>
</Layout>

<script>
  import { claveMejor, leerJson, type Resultado } from '../../lib/ejercicios';

  // Muestra el mejor resultado de cada sección, si existe
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-seccion]').forEach((tarjeta) => {
      const mejor = leerJson<Resultado | null>(claveMejor(tarjeta.dataset.seccion!), null);
      const texto = tarjeta.querySelector<HTMLElement>('.mejor');
      if (mejor && texto) {
        texto.textContent = `Mejor resultado: ${mejor.aciertos}/${mejor.total}`;
        texto.hidden = false;
      }
    });
  });
</script>
