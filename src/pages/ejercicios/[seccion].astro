---
// Examen de una sección: sortea preguntas del banco, corrige al momento y muestra el resultado al final.
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { ui } from '../../contenido/ui';
import { EJERCICIOS as E } from '../../contenido/inicio';
import { SECCIONES, type Seccion } from '../../contenido/ejercicios/index';
import { prepararPreguntas } from '../../lib/preparar-ejercicios';

export function getStaticPaths() {
  return SECCIONES.map((s) => ({ params: { seccion: s.id }, props: { seccion: s } }));
}

interface Props {
  seccion: Seccion;
}

const { seccion } = Astro.props;
const datos = {
  id: seccion.id,
  porIntento: seccion.porIntento,
  cuotas: seccion.cuotas,
  temas: seccion.temas,
  preguntas: await prepararPreguntas(seccion.preguntas),
};
---

<Layout title={`Ejercicios de ${seccion.titulo} · Arquetipo`} description={`${seccion.descripcion} ${seccion.preguntas.length} preguntas; cada intento sortea ${seccion.porIntento}.`}>
  <Navbar />

  <main class="w-full bg-background min-h-screen">
    <div class="max-w-[900px] mx-auto px-4 sm:px-6 lg:px-10 py-8 flex flex-col gap-8">
      <header class="flex flex-col gap-3">
        <nav class="flex flex-wrap items-center gap-2 font-telemetry text-xs text-on-surface-variant" aria-label={ui.ruta}>
          <a href="/" class="hover:text-primary">{ui.inicio}</a>
          <span>/</span>
          <a href="/ejercicios" class="hover:text-primary">{E.titulo}</a>
          <span>/</span>
          <span class={seccion.color}>{seccion.titulo}</span>
        </nav>
        <h1 class="font-headline text-3xl sm:text-4xl font-bold text-primary flex items-center gap-3">
          <span class={`material-symbols-outlined text-[34px] ${seccion.color}`}>{seccion.icono}</span>{seccion.titulo}
        </h1>
        <p class="font-body text-base text-slate-300 leading-relaxed">{seccion.descripcion}</p>
      </header>

      <section id="examen" data-examen class="scroll-mt-24 p-5 sm:p-8 rounded-xl bg-surface-container-lowest/90 border border-surface-container-high">
        <!-- Inicio -->
        <div data-vista="inicio" class="flex flex-col items-start gap-5">
          <dl class="grid grid-cols-2 sm:grid-cols-3 gap-6">
            <div>
              <dt class="font-badge text-[10px] uppercase tracking-wider text-on-surface-variant">Banco de preguntas</dt>
              <dd class="font-code text-2xl font-bold text-slate-100">{seccion.preguntas.length}</dd>
            </div>
            <div>
              <dt class="font-badge text-[10px] uppercase tracking-wider text-on-surface-variant">Por intento</dt>
              <dd class="font-code text-2xl font-bold text-slate-100">{seccion.porIntento}</dd>
            </div>
            <div>
              <dt class="font-badge text-[10px] uppercase tracking-wider text-on-surface-variant">Mejor resultado</dt>
              <dd data-mejor class="font-code text-2xl font-bold text-slate-100">—</dd>
            </div>
          </dl>
          <p class="font-body text-sm text-slate-300 leading-relaxed">
            Las preguntas y el orden de las alternativas cambian en cada intento, y se priorizan las que no te salieron hace poco.
            Al responder verás al momento si acertaste y por qué. Puedes elegir con el ratón o con las teclas 1 a 4.
          </p>
          <button type="button" data-empezar class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-primary-container text-on-primary font-body text-sm font-semibold hover:bg-primary transition-colors">
            Empezar intento <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
          </button>
        </div>

        <!-- Pregunta actual -->
        <div data-vista="pregunta" hidden class="flex flex-col gap-5">
          <div class="h-1.5 rounded-full bg-surface-container-high overflow-hidden" aria-hidden="true">
            <div data-barra class="h-full bg-primary-container transition-all" style="width: 0%"></div>
          </div>
          <div data-contenedor></div>
          <div class="flex justify-end">
            <button type="button" data-siguiente hidden class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-primary-container text-on-primary font-body text-sm font-semibold hover:bg-primary transition-colors">
              <span data-texto-siguiente>Siguiente</span> <span class="material-symbols-outlined text-[18px]">arrow_forward</span>
            </button>
          </div>
        </div>

        <!-- Resultado -->
        <div data-vista="resultado" hidden class="flex flex-col gap-6">
          <div class="flex flex-col items-center text-center gap-2">
            <span class="font-badge text-[11px] uppercase tracking-wider text-on-surface-variant">Tu resultado</span>
            <span data-puntaje class="font-headline text-6xl font-bold text-primary-container"></span>
            <p data-mensaje class="font-body text-base text-slate-200"></p>
          </div>
          <div class="flex flex-wrap justify-center gap-3">
            <button type="button" data-otro class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-primary-container text-on-primary font-body text-sm font-semibold hover:bg-primary transition-colors">
              <span class="material-symbols-outlined text-[18px]">refresh</span>Otro intento
            </button>
            <a href="/ejercicios" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-surface-container-high hover:bg-surface-variant text-primary font-body text-sm font-medium transition-colors">
              Elegir otra sección
            </a>
          </div>
          <h2 class="font-badge text-xs uppercase tracking-wider text-on-surface-variant pt-4 border-t border-surface-container-high">Revisión</h2>
          <ol data-revision class="flex flex-col gap-3"></ol>
        </div>
      </section>
    </div>
    <Footer />
  </main>
</Layout>

<script is:inline type="application/json" id="datos-examen" set:html={JSON.stringify(datos).replace(/</g, '\\u003c')}></script>

<script>
  import {
    claveMejor, claveRecientes, conCodigo, dibujarPregunta, escapar, guardarJson, leerJson, sortear,
    type Cuota, type PreguntaCliente, type Resultado, type TemaCliente,
  } from '../../lib/ejercicios';

  interface Datos { id: string; porIntento: number; cuotas: Cuota[]; temas: TemaCliente[]; preguntas: PreguntaCliente[] }
  interface Respuesta { pregunta: PreguntaCliente; elegida: string; acerto: boolean }

  function iniciar() {
    const examen = document.querySelector<HTMLElement>('[data-examen]');
    const fuente = document.getElementById('datos-examen');
    if (!examen || !fuente || examen.dataset.listo) return;
    examen.dataset.listo = 'true';

    const datos = JSON.parse(fuente.textContent!) as Datos;
    const temas = new Map(datos.temas.map((t) => [t.id, t]));
    const $ = <T extends HTMLElement>(sel: string) => examen.querySelector<T>(sel)!;
    const vistas = examen.querySelectorAll<HTMLElement>('[data-vista]');
    const mostrar = (nombre: string) => vistas.forEach((v) => { v.hidden = v.dataset.vista !== nombre; });

    let preguntas: PreguntaCliente[] = [];
    let respuestas: Respuesta[] = [];
    let actual = 0;

    const pintarMejor = () => {
      const mejor = leerJson<Resultado | null>(claveMejor(datos.id), null);
      $('[data-mejor]').textContent = mejor ? `${mejor.aciertos}/${mejor.total}` : '—';
    };

    const pintarPregunta = () => {
      const p = preguntas[actual];
      const contenedor = $('[data-contenedor]');
      const siguiente = $<HTMLButtonElement>('[data-siguiente]');
      siguiente.hidden = true;
      $('[data-texto-siguiente]').textContent = actual === preguntas.length - 1 ? 'Ver resultado' : 'Siguiente';
      $('[data-barra]').style.width = `${(actual / preguntas.length) * 100}%`;
      const caja = dibujarPregunta(p, {
        tema: temas.get(p.tema),
        encabezado: `Pregunta ${actual + 1} de ${preguntas.length}`,
        alResponder: (acerto, elegida) => {
          respuestas.push({ pregunta: p, elegida, acerto });
          siguiente.hidden = false;
          siguiente.focus({ preventScroll: true });
        },
      });
      caja.tabIndex = -1;
      contenedor.replaceChildren(caja);
      caja.focus({ preventScroll: true });
    };

    const terminar = () => {
      const aciertos = respuestas.filter((r) => r.acerto).length;
      const total = respuestas.length;
      const mejor = leerJson<Resultado | null>(claveMejor(datos.id), null);
      if (!mejor || aciertos / total > mejor.aciertos / mejor.total) guardarJson(claveMejor(datos.id), { aciertos, total });
      const nota = aciertos / total;
      $('[data-puntaje]').textContent = `${aciertos}/${total}`;
      $('[data-mensaje]').textContent =
        nota === 1 ? '¡Perfecto! Prueba otro intento: saldrán preguntas distintas.'
        : nota >= 0.8 ? 'Muy bien. Revisa las que fallaste y vuelve a intentarlo.'
        : nota >= 0.5 ? 'Vas bien. Repasa los temas de las preguntas que fallaste.'
        : 'Conviene repasar los temas antes del siguiente intento.';
      $('[data-revision]').innerHTML = respuestas
        .map(({ pregunta: p, elegida, acerto }) => {
          const tema = temas.get(p.tema);
          return `<li class="p-4 rounded-lg border ${acerto ? 'border-surface-container-high' : 'border-rose-400/30'} bg-surface-container-low flex gap-3">
            <span class="shrink-0 w-6 h-6 rounded font-code text-xs font-bold flex items-center justify-center ${acerto ? 'bg-secondary-container text-on-secondary' : 'bg-rose-400 text-slate-950'}">${acerto ? '✓' : '✕'}</span>
            <div class="flex flex-col gap-1.5 min-w-0 font-body text-sm leading-relaxed">
              <p class="text-slate-100">${conCodigo(p.pregunta)}</p>
              ${acerto ? '' : `<p class="text-rose-300">Tu respuesta: ${conCodigo(elegida)}</p>`}
              <p class="text-secondary-container">Correcta: ${conCodigo(p.correcta)}</p>
              <p class="text-slate-300">${conCodigo(p.explicacion)}</p>
              ${tema ? `<a href="${escapar(tema.href)}" class="font-badge text-[11px] uppercase tracking-wider text-primary-container hover:text-primary-fixed">Repasar: ${escapar(tema.nombre)} →</a>` : ''}
            </div>
          </li>`;
        })
        .join('');
      mostrar('resultado');
      examen.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    const empezar = () => {
      const recientes = new Set(leerJson<string[]>(claveRecientes(datos.id), []));
      preguntas = sortear(datos.preguntas, datos.cuotas, recientes);
      // Se recuerdan las preguntas de los dos últimos intentos para no repetirlas enseguida
      guardarJson(claveRecientes(datos.id), [...preguntas.map((p) => p.id), ...recientes].slice(0, datos.porIntento * 2));
      respuestas = [];
      actual = 0;
      mostrar('pregunta');
      pintarPregunta();
      examen.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    $('[data-empezar]').addEventListener('click', empezar);
    $('[data-otro]').addEventListener('click', empezar);
    $('[data-siguiente]').addEventListener('click', () => {
      actual++;
      if (actual < preguntas.length) pintarPregunta();
      else terminar();
    });
    pintarMejor();
  }

  document.addEventListener('astro:page-load', iniciar);
</script>
