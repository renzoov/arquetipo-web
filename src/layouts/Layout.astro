---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { META } from '../contenido/inicio';
import Buscador from '../components/Buscador.astro';
import { URL_ICONOS } from '../lib/iconos';

interface Props {
	title?: string;
	description?: string;
	/** Página de error: no se indexa. */
	noIndex?: boolean;
}

const { title = META.titulo, description = META.descripcion, noIndex = false } = Astro.props;

// URLs absolutas solo si se conoce el dominio (variable SITE_URL al compilar)
const absoluta = (ruta: string) => (Astro.site ? new URL(ruta, Astro.site).href : undefined);
const canonica = absoluta(Astro.url.pathname);
const imagen = absoluta('/og.png');
---

<!doctype html>
<html class="dark" lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noIndex && <meta name="robots" content="noindex" />}
		{!noIndex && canonica && <link rel="canonical" href={canonica} />}

		<!-- Vista previa al compartir (Open Graph y Twitter) -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Arquetipo" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content="es_ES" />
		{canonica && <meta property="og:url" content={canonica} />}
		{imagen && <meta property="og:image" content={imagen} />}
		{imagen && <meta property="og:image:width" content="1200" />}
		{imagen && <meta property="og:image:height" content="630" />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{imagen && <meta name="twitter:image" content={imagen} />}

		<!-- Preconnect fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

		<!-- Google Fonts: Space Grotesk, Geist, JetBrains Mono -->
		<link
			href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
			rel="stylesheet"
		/>

		<!-- Material Symbols: solo los íconos que usa la web (ver src/lib/iconos.ts) -->
		<link href={URL_ICONOS} rel="stylesheet" />

		<!-- Transiciones animadas entre páginas (View Transitions) -->
		<ClientRouter />
	</head>
	<body class="bg-background text-on-surface antialiased selection:bg-primary-container selection:text-on-primary-container">
		<slot />
		<Buscador />

		<script>
			// Ajusta el alto de cada diagrama de Archify (iframe) a su contenido real,
			// para que no salga cortado ni deje espacio vacío al final.
			function fitFrame(frame: HTMLIFrameElement) {
				const doc = frame.contentDocument;
				const win = frame.contentWindow;
				if (!doc || !win || !doc.body) return;
				const content = doc.querySelector('.container') ?? doc.body;
				// Fondo del último elemento visible (ignora rellenos internos de Archify).
				let bottom = 0;
				for (const child of Array.from(content.children)) {
					const rect = child.getBoundingClientRect();
					if (rect.height > 0) bottom = Math.max(bottom, rect.bottom);
				}
				if (!bottom) bottom = content.getBoundingClientRect().bottom;
				// Mismo margen abajo que el relleno superior del diagrama.
				const margin = parseFloat(win.getComputedStyle(doc.body).paddingTop) || 20;
				const height = Math.ceil(bottom + win.scrollY + margin);
				if (height <= 0) return;

				// Protección anti-parpadeo: ignora cambios mínimos y, si el alto
				// empieza a oscilar entre dos valores, se queda con el mayor.
				const current = parseFloat(frame.style.height) || 0;
				if (Math.abs(height - current) <= 2) return;
				const previous = parseFloat(frame.dataset.prevHeight || '0');
				const next = Math.abs(height - previous) <= 2 ? Math.max(height, current) : height;
				frame.dataset.prevHeight = String(current);
				if (next !== current) frame.style.height = `${next}px`;
			}

			function watchFrame(frame: HTMLIFrameElement) {
				const setup = () => {
					// Un iframe que aún no se carga contiene about:blank: no hay nada que medir
					if (!frame.contentDocument || frame.contentDocument.URL === 'about:blank') return;
					fitFrame(frame);
					const doc = frame.contentDocument;
					const target = doc?.querySelector('.container') ?? doc?.body;
					if (target && 'ResizeObserver' in window) {
						new ResizeObserver(() => fitFrame(frame)).observe(target);
					}
					// Las fuentes del diagrama pueden cambiar el alto al terminar de cargar.
					doc?.fonts?.ready.then(() => fitFrame(frame));
				};
				frame.addEventListener('load', setup);
				if (frame.contentDocument?.readyState === 'complete' && frame.contentDocument.URL !== 'about:blank') setup();
			}

			// Los diagramas pesan (cada uno ejecuta bastante JavaScript): se cargan al acercarse a ellos.
			// Su alto ya viene reservado por DiagramaArchify, así que cargarlos no mueve la página.
			const cargar = (frame: HTMLIFrameElement) => {
				if (!frame.src && frame.dataset.src) frame.src = frame.dataset.src;
			};
			const cercania = 'IntersectionObserver' in window
				? new IntersectionObserver((entradas, observador) => {
					for (const entrada of entradas) {
						if (!entrada.isIntersecting) continue;
						observador.unobserve(entrada.target);
						cargar(entrada.target as HTMLIFrameElement);
					}
				}, { rootMargin: '400px 0px' })
				: null;

			// Con View Transitions el script se carga una sola vez: se reaplica en cada navegación.
			document.addEventListener('astro:page-load', () => {
				document.querySelectorAll<HTMLIFrameElement>('iframe.archify-frame').forEach((frame) => {
					watchFrame(frame);
					if (cercania) cercania.observe(frame);
					else cargar(frame);
				});
			});
		</script>
	</body>
</html>
