---
import Logo from './Logo.astro';
---

<footer class="w-full border-t border-surface-container-high/60 mt-8">
  <div class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-10 py-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3">
      <Logo size={30} />
      <span class="flex flex-col leading-tight">
        <span class="font-headline text-base font-bold text-primary">Arquetipo</span>
        <span class="font-body text-xs text-on-surface-variant">Guía de diseño de software: POO, SOLID y patrones.</span>
      </span>
    </a>
    <nav class="flex flex-wrap gap-x-5 gap-y-2 font-body text-sm text-on-surface-variant" aria-label="Pie de página">
      <a href="/fundamentos/poo" class="hover:text-primary transition-colors">POO</a>
      <a href="/principios/diseno" class="hover:text-primary transition-colors">Diseño</a>
      <a href="/principios/solid" class="hover:text-primary transition-colors">SOLID</a>
      <a href="/#patrones" class="hover:text-primary transition-colors">Patrones</a>
      <a href="/#lenguajes" class="hover:text-primary transition-colors">Lenguajes</a>
    </nav>
    <span class="font-telemetry text-[11px] text-outline">Libre y sin registro</span>
  </div>
</footer>
