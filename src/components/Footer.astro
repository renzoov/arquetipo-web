---
import Logo from './Logo.astro';
import { ui } from '../contenido/ui';

const enlaces = [
  { href: '/fundamentos/poo', label: ui.navPoo },
  { href: '/principios/diseno', label: ui.navDiseno },
  { href: '/principios/solid', label: ui.navSolid },
  { href: '/#patrones', label: ui.navPatrones },
  { href: '/#lenguajes', label: ui.navLenguajes },
  { href: '/comparaciones', label: ui.navComparar },
  { href: '/antipatrones', label: ui.navAntipatrones },
  { href: '/ejercicios', label: ui.navEjercicios },
];
---

<footer class="w-full border-t border-surface-container-high/60 mt-8">
  <div class="max-w-[1320px] mx-auto px-4 sm:px-6 lg:px-10 py-8 flex flex-col md:flex-row md:items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3">
      <Logo size={30} />
      <span class="flex flex-col leading-tight">
        <span class="font-headline text-base font-bold text-primary">Arquetipo</span>
        <span class="font-body text-xs text-on-surface-variant">{ui.pieDescripcion}</span>
      </span>
    </a>
    <nav class="flex flex-wrap gap-x-5 gap-y-2 font-body text-sm text-on-surface-variant" aria-label={ui.pieNav}>
      {enlaces.map((e) => <a href={e.href} class="hover:text-primary transition-colors">{e.label}</a>)}
    </nav>
    <span class="font-telemetry text-[11px] text-outline">{ui.pieLibre}</span>
  </div>
</footer>
