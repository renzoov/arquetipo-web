---
import Logo from './Logo.astro';
import { ui } from '../contenido/ui';

const path = Astro.url.pathname;
const links = [
  { href: '/fundamentos/poo', label: ui.navPoo, icon: 'account_tree', active: path.startsWith('/fundamentos') },
  { href: '/principios/diseno', label: ui.navDiseno, icon: 'lightbulb', active: path.startsWith('/principios/diseno') },
  { href: '/principios/solid', label: ui.navSolid, icon: 'memory', active: path.startsWith('/principios/solid') },
  { href: '/#patrones', label: ui.navPatrones, icon: 'category', active: path.startsWith('/patrones') },
  { href: '/#lenguajes', label: ui.navLenguajes, icon: 'code_blocks', active: path.startsWith('/lenguajes') },
];
// Guías de profundización: van en el menú "Más" para no saturar la barra
const extras = [
  { href: '/comparaciones', label: ui.navComparar, icon: 'compare_arrows', active: path.startsWith('/comparaciones') },
  { href: '/antipatrones', label: ui.navAntipatrones, icon: 'report', active: path.startsWith('/antipatrones') },
];
const masActivo = extras.some((e) => e.active);
const claseActivo = 'bg-primary-container/15 text-primary-container';
const claseInactivo = 'text-on-surface-variant hover:text-primary hover:bg-surface-container-high';
---

<header transition:name="cabecera" transition:animate="none" class="sticky top-0 z-50 w-full bg-surface-container-lowest/85 backdrop-blur-xl border-b border-surface-container-high/60">
  <div class="max-w-[1320px] mx-auto h-16 px-4 sm:px-6 lg:px-10 flex items-center justify-between gap-3">
    <!-- Marca -->
    <a href="/" class="flex items-center gap-3 group shrink-0" aria-label={ui.irAlInicio}>
      <Logo size={36} class="transition-transform group-hover:scale-105" />
      <span class="flex flex-col leading-none">
        <span class="font-headline text-lg font-bold text-primary tracking-tight">Arquetipo</span>
        <span class="hidden sm:block lg:hidden xl:block font-telemetry text-[10px] text-on-surface-variant mt-1">{ui.marcaSubtitulo}</span>
      </span>
    </a>

    <!-- Navegación (escritorio) -->
    <nav class="hidden lg:flex items-center gap-1 p-1 rounded-full bg-surface-container-low/80 border border-surface-container-high" aria-label={ui.secciones}>
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={l.active ? 'page' : undefined}
          class={`flex items-center gap-1.5 px-3.5 py-1.5 rounded-full font-body text-[13px] font-medium transition-colors ${l.active ? claseActivo : claseInactivo}`}
        >
          <span class="material-symbols-outlined text-[17px]">{l.icon}</span>
          {l.label}
        </a>
      ))}
      <details class="relative">
        <summary class={`list-none cursor-pointer flex items-center gap-1 pl-3.5 pr-2.5 py-1.5 rounded-full font-body text-[13px] font-medium transition-colors [&::-webkit-details-marker]:hidden ${masActivo ? claseActivo : claseInactivo}`}>
          {ui.navMas}<span class="material-symbols-outlined text-[17px]">expand_more</span>
        </summary>
        <div class="absolute right-0 top-11 w-64 p-2 rounded-xl bg-surface-container-low border border-surface-container-high shadow-2xl flex flex-col gap-1">
          {extras.map((l) => (
            <a href={l.href} aria-current={l.active ? 'page' : undefined} class={`flex items-center gap-2.5 px-3 py-2.5 rounded-lg font-body text-sm ${l.active ? claseActivo : 'text-on-surface hover:bg-surface-container-high'}`}>
              <span class="material-symbols-outlined text-[19px]">{l.icon}</span>{l.label}
            </a>
          ))}
        </div>
      </details>
    </nav>

    <div class="flex items-center gap-2 min-w-0">
      <!-- Buscador: parece una caja de texto y abre el buscador completo -->
      <button type="button" data-abrir-buscador aria-label={ui.buscar}
        class="flex items-center gap-2 h-10 w-40 sm:w-56 lg:w-44 xl:w-60 min-w-0 px-3 rounded-lg border border-surface-container-high bg-surface-container-low text-left text-on-surface-variant hover:border-primary-container/40 transition-colors">
        <span class="material-symbols-outlined text-[20px] text-primary-container shrink-0">search</span>
        <span class="flex-1 truncate font-body text-sm">{ui.buscar}…</span>
        <kbd class="hidden sm:inline lg:hidden xl:inline font-telemetry text-[10px] px-1.5 py-0.5 rounded border border-surface-container-high shrink-0">Ctrl K</kbd>
      </button>

      <!-- Menú móvil -->
      <details class="lg:hidden relative shrink-0">
        <summary class="list-none cursor-pointer w-10 h-10 rounded-lg border border-surface-container-high bg-surface-container-low flex items-center justify-center text-primary [&::-webkit-details-marker]:hidden" aria-label={ui.abrirMenu}>
          <span class="material-symbols-outlined text-[22px] icono-menu">menu</span>
          <span class="material-symbols-outlined text-[22px] icono-cerrar">close</span>
        </summary>
        <nav class="absolute right-0 top-12 w-60 p-2 rounded-xl bg-surface-container-low border border-surface-container-high shadow-2xl flex flex-col gap-1" aria-label={ui.secciones}>
          {[...links, ...extras].map((l) => (
            <a href={l.href} class={`flex items-center gap-2.5 px-3 py-2.5 rounded-lg font-body text-sm ${l.active ? claseActivo : 'text-on-surface hover:bg-surface-container-high'}`}>
              <span class="material-symbols-outlined text-[19px]">{l.icon}</span>
              {l.label}
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Cierra los menús desplegables al hacer clic fuera de ellos (se registra una sola vez)
  document.addEventListener('click', (evento) => {
    document.querySelectorAll<HTMLDetailsElement>('header details[open]').forEach((menu) => {
      if (!menu.contains(evento.target as Node)) menu.open = false;
    });
  });
</script>

<style>
  .icono-cerrar { display: none; }
  details[open] .icono-menu { display: none; }
  details[open] .icono-cerrar { display: inline; }
</style>
