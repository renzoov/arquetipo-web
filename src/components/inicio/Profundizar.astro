---
// Guías para profundizar después del catálogo: comparaciones, antipatrones y ejercicios.
import { PROFUNDIZAR } from '../../contenido/inicio';
---

<section id="profundizar" class="scroll-mt-24 flex flex-col gap-5">
  <div>
    <span class="font-badge text-[10px] text-primary-container uppercase tracking-widest">{PROFUNDIZAR.etiqueta}</span>
    <h2 class="font-headline text-2xl font-bold uppercase text-primary mt-1">{PROFUNDIZAR.titulo}</h2>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {PROFUNDIZAR.tarjetas.map((c) => (
      <a href={c.href} class={`p-5 rounded-xl bg-surface-container-lowest/90 border border-surface-container-high ${c.borde} transition-all flex gap-4`}>
        <span class={`w-11 h-11 shrink-0 rounded-lg bg-surface-container-high flex items-center justify-center ${c.color}`}>
          <span class="material-symbols-outlined text-[24px]">{c.icono}</span>
        </span>
        <span class="flex flex-col gap-1.5">
          <h3 class="font-code text-sm font-bold text-slate-100">{c.titulo}</h3>
          <p class="font-body text-xs text-slate-300 leading-relaxed">{c.texto}</p>
          <span class={`mt-1 font-badge text-[10px] uppercase tracking-wider ${c.color}`}>{c.accion}</span>
        </span>
      </a>
    ))}
  </div>
</section>
