---
// Guías para profundizar después del catálogo: comparaciones entre patrones parecidos.
import { PROFUNDIZAR } from '../../contenido/inicio';
import { t, ruta, type Idioma } from '../../i18n/idiomas';

interface Props {
  idioma: Idioma;
}

const { idioma } = Astro.props;
---

<section id="profundizar" class="scroll-mt-24 flex flex-col gap-5">
  <div>
    <span class="font-badge text-[10px] text-primary-container uppercase tracking-widest">{t(PROFUNDIZAR.etiqueta, idioma)}</span>
    <h2 class="font-headline text-2xl font-bold uppercase text-primary mt-1">{t(PROFUNDIZAR.titulo, idioma)}</h2>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {PROFUNDIZAR.tarjetas.map((c) => (
      <a href={ruta(idioma, c.href)} class={`p-5 rounded-xl bg-surface-container-lowest/90 border border-surface-container-high ${c.borde} transition-all flex gap-4`}>
        <span class={`w-11 h-11 shrink-0 rounded-lg bg-surface-container-high flex items-center justify-center ${c.color}`}>
          <span class="material-symbols-outlined text-[24px]">{c.icono}</span>
        </span>
        <span class="flex flex-col gap-1.5">
          <h3 class="font-code text-sm font-bold text-slate-100">{t(c.titulo, idioma)}</h3>
          <p class="font-body text-xs text-slate-300 leading-relaxed">{t(c.texto, idioma)}</p>
          <span class={`mt-1 font-badge text-[10px] uppercase tracking-wider ${c.color}`}>{t(c.accion, idioma)}</span>
        </span>
      </a>
    ))}
  </div>
</section>
