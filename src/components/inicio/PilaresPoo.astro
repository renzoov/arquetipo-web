---
// Resumen de los 4 pilares de la POO.
import { PILARES_RESUMEN as P } from '../../contenido/inicio';

const guia = '/fundamentos/poo';
---

<section id="poo" class="scroll-mt-24 flex flex-col gap-5">
  <div class="flex items-end justify-between flex-wrap gap-3">
    <div>
      <span class="font-badge text-[10px] text-secondary-container uppercase tracking-widest">{P.paso}</span>
      <h2 class="font-headline text-2xl font-bold uppercase text-primary mt-1">{P.titulo}</h2>
    </div>
    <a href={guia} class="font-badge text-[11px] uppercase tracking-wider text-secondary-container hover:text-secondary-fixed">{P.verGuia}</a>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    {P.pilares.map((p) => (
      <a href={`${guia}#${p.id}`} class="p-5 rounded-xl bg-surface-container-lowest/90 border border-surface-container-high hover:border-secondary-container/40 transition-all flex flex-col gap-3">
        <span class={`w-10 h-10 rounded-lg flex items-center justify-center ${p.fondo} ${p.color}`}>
          <span class="material-symbols-outlined text-[22px]">{p.icono}</span>
        </span>
        <h3 class="font-code text-sm font-bold text-slate-100">{p.nombre}</h3>
        <p class="font-body text-xs text-slate-300 leading-relaxed">{p.idea}</p>
      </a>
    ))}
  </div>
  <p class="font-body text-sm text-slate-300 px-4 py-3 rounded-lg bg-primary-container/5 border border-primary-container/20">
    <span class="font-telemetry text-xs text-primary-container font-bold">{P.regla}</span>
    {P.reglaTexto}
  </p>
</section>
