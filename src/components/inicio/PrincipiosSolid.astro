---
// Resumen de los 5 principios SOLID.
import { SOLID_RESUMEN as S } from '../../contenido/inicio';
import { PRINCIPIOS_SOLID } from '../../contenido/solid';

const pagina = '/principios/solid';
---

<section id="solid" class="scroll-mt-24 flex flex-col gap-5">
  <div class="flex items-end justify-between flex-wrap gap-3">
    <div>
      <span class="font-badge text-[10px] text-primary-container uppercase tracking-widest">{S.paso}</span>
      <h2 class="font-headline text-2xl font-bold uppercase text-primary mt-1">{S.titulo}</h2>
    </div>
    <a href={pagina} class="font-badge text-[11px] uppercase tracking-wider text-primary-container hover:text-primary-fixed">{S.verTodos}</a>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
    {PRINCIPIOS_SOLID.map((s) => (
      <a href={`${pagina}#${s.id}`} class={`p-5 rounded-xl bg-surface-container-lowest/90 border border-surface-container-high ${s.borde} transition-all flex flex-col gap-3`}>
        <span class={`w-9 h-9 rounded border font-headline text-lg font-bold flex items-center justify-center ${s.fondo} ${s.color}`}>{s.letra}</span>
        <h3 class="font-code text-sm font-bold text-slate-100">{s.nombre}</h3>
        <p class="font-body text-xs text-slate-300 leading-relaxed">{s.idea}</p>
        <p class="mt-auto pt-3 border-t border-surface-container-high font-body text-xs text-amber-300/90 leading-relaxed">
          <span class="font-telemetry font-bold">{S.sintoma}</span> {s.sintomaCorto}
        </p>
      </a>
    ))}
  </div>
</section>
